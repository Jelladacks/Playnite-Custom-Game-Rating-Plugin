
<controls:PluginUserControl
    x:Class="CustomGameRating.GameReviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK">

    <Grid Margin="10">
        <StackPanel x:Name="ReviewContent"
                    Visibility="Collapsed">

            <!-- 종합 점수 -->
            <DockPanel Margin="0,0,0,15">
                <TextBlock Text="{DynamicResource LOC_CGR_Review_MyRating}"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Style="{DynamicResource BaseTextBlockStyle}"
                           />

                <TextBlock x:Name="AverageScoreText"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource GameRatingStarBrush}"/>
            </DockPanel>

            <!-- 항목별 점수 -->
            <TextBlock Text="{DynamicResource LOC_CGR_Review_Detail}"
                    FontWeight="Bold"
                    Margin="0,0,0,8"
                    Style="{DynamicResource BaseTextBlockStyle}"/>

            <!-- 설정에 따라 동적으로 생성되는 평가 항목 -->
            <StackPanel x:Name="CategoryRows"/>

            <!-- 후기 -->
            <TextBlock Text="{DynamicResource LOC_CGR_Review_MyReview}"
                       FontWeight="Bold"
                       Margin="0,18,0,8"
                       Style="{DynamicResource BaseTextBlockStyle}"/>

            <TextBlock x:Name="ReviewText"
                       TextWrapping="Wrap"
                       MinHeight="30"
                       Style="{DynamicResource BaseTextBlockStyle}"/>

        </StackPanel>

        <!-- 미평가 상태 -->
        <Button x:Name="EmptyMessage"
                Click="EmptyMessage_Click"
                Visibility="Collapsed"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Padding="12"
                Cursor="Hand"
                ToolTip="{DynamicResource LOC_CGR_Review_ClickToRate}">

            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="＋"
                        FontSize="28"
                        Foreground="{DynamicResource GameRatingStarBrush}"
                        HorizontalAlignment="Center"/>

                <TextBlock Text="{DynamicResource LOC_CGR_Review_NotRatedYet}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Style="{DynamicResource BaseTextBlockStyle}"
                        HorizontalAlignment="Center"/>

                <TextBlock Text="{DynamicResource LOC_CGR_Review_ClickToRateHint}"
                        FontSize="11"
                        Opacity="0.65"
                        Style="{DynamicResource BaseTextBlockStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,0"/>
            </StackPanel>
        </Button>
    </Grid>
</controls:PluginUserControl>
