
<UserControl x:Class="CustomGameRating.RatingStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CustomGameRating">

    <UserControl.Resources>
        <!-- 자기 가로 길이 × 비율로 세로 길이를 정하는 변환기 -->
        <local:AspectRatioConverter x:Key="AspectRatioConverter"/>

        <local:OffsetConverter x:Key="OffsetConverter"/>

        <!-- 카드 하단 텍스트 영역만 가리는 반투명 배경 -->
        <SolidColorBrush x:Key="CardTextOverlayBrush" Color="#B8000000"/>

        <!-- 게임 카드 하단 반투명 레이어: 기본은 카드 세로 길이의 2/9
             (최저/최근 평가 게임은 최고 평가 게임 레이어 높이, 선호하는 게임은 2/5로 개별 지정)
             (바로 위 Grid = 카드 내부 Grid의 높이를 기준으로 함) -->
        <Style x:Key="CardTextOverlayStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardTextOverlayBrush}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Height"
                    Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource AspectRatioConverter}, ConverterParameter=2/9}"/>
        </Style>

        <!-- 레이어 높이에 글자가 다 안 들어가면 글자만 비율대로 줄임 (커지지는 않음) -->
        <Style x:Key="CardTextFitStyle" TargetType="Viewbox">
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28">

            <!-- 페이지 제목 -->
            <TextBlock Text="{DynamicResource LOC_CGR_StatisticsTitle}"
                       FontSize="{DynamicResource FontSizeLargest}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,24"/>

            <!-- 전체 평가 요약 제목 (대시보드 전체 위) -->
            <TextBlock Text="{DynamicResource LOC_CGR_Stats_Summary}"
                       FontSize="{DynamicResource FontSizeLarger}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,12"/>

            <!-- 상단 대시보드 -->
            <Grid x:Name="DashboardGrid"
                  Margin="0,0,0,28"
                  SizeChanged="DashboardGrid_SizeChanged">
                <!-- 기본 2:3, 오른쪽 카드 두 개가 최대 크기면 오른쪽을 필요한 만큼만 (코드에서 변경) -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SummaryColumn" Width="2*"/>
                    <ColumnDefinition x:Name="CardColumn" Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- 왼쪽 영역: 글자 크기는 대시보드 너비에 맞춰 코드에서 비율 조정 -->
                <Grid x:Name="SummaryPanel"
                      Grid.Column="0"
                      Margin="0,0,12,0"
                      SizeChanged="SummaryPanel_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 전체 게임 / 평가 완료 / 미평가 / 전체 평균:
                         배치는 4칸 그대로, 배경은 바깥 Border 하나만 있어 카드 한 장처럼 보임 -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource GridItemBackgroundBrush}"
                            CornerRadius="8"
                            Padding="4"
                            Margin="4,4,4,16">
                    <UniformGrid Columns="2">

                        <Border Padding="14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource LOC_CGR_Stats_TotalGames}"
                                           Foreground="{DynamicResource TextBrushDarker}"/>
                                <TextBlock x:Name="TotalGamesText"
                                           Text="0"
                                           FontSize="{DynamicResource FontSizeLargest}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource LOC_CGR_Stats_Rated}"
                                           Foreground="{DynamicResource TextBrushDarker}"/>
                                <TextBlock x:Name="RatedGamesText"
                                           Text="0"
                                           FontSize="{DynamicResource FontSizeLargest}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource GlyphBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource LOC_CGR_Stats_Unrated}"
                                           Foreground="{DynamicResource TextBrushDarker}"/>
                                <TextBlock x:Name="UnratedGamesText"
                                           Text="0"
                                           FontSize="{DynamicResource FontSizeLargest}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource LOC_CGR_Stats_OverallAverage}"
                                           Foreground="{DynamicResource TextBrushDarker}"/>
                                <TextBlock x:Name="OverallAverageText"
                                           Text="0"
                                           FontSize="{DynamicResource FontSizeLargest}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource GameRatingStarBrush}"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>
                    </Border>

                    <!-- 평가 진행률 -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource GridItemBackgroundBrush}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="4,0,4,12">

                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource LOC_CGR_Stats_Progress}"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock x:Name="RatedPercentageText"
                                           Text="0%"
                                           HorizontalAlignment="Right"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource GameRatingStarBrush}"/>
                            </Grid>

                            <ProgressBar x:Name="RatedProgressBar"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Height="12"
                                         Foreground="{DynamicResource GameRatingStarBrush}"/>
                        </StackPanel>

                    </Border>

                    <!-- 하단: 후한/깐깐한 평가 요소 + 최저 평가 게임(작은 카드) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="0.75*"/>
                        </Grid.ColumnDefinitions>

                        <UniformGrid Grid.Column="0"
                                     Rows="2"
                                     Columns="1">

                            <!-- 후한 평가 요소 -->
                            <Border Background="{DynamicResource GridItemBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="4">

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource LOC_CGR_Stats_MostGenerous}"
                                               Foreground="{DynamicResource PositiveRatingBrush}"/>

                                    <TextBlock x:Name="MostGenerousCategoryText"
                                               Text="-"
                                               FontSize="{DynamicResource FontSizeLarger}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,8,0,4"/>

                                    <TextBlock x:Name="MostGenerousScoreText"
                                               Text="{DynamicResource LOC_CGR_NoRatingData}"
                                               Foreground="{DynamicResource GameRatingStarBrush}"/>
                                </StackPanel>

                            </Border>

                            <!-- 깐깐한 평가 요소 -->
                            <Border Background="{DynamicResource GridItemBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="4">

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource LOC_CGR_Stats_Strictest}"
                                               Foreground="{DynamicResource NegativeRatingBrush}"/>

                                    <TextBlock x:Name="StrictestCategoryText"
                                               Text="-"
                                               FontSize="{DynamicResource FontSizeLarger}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,8,0,4"/>

                                    <TextBlock x:Name="StrictestScoreText"
                                               Text="{DynamicResource LOC_CGR_NoRatingData}"
                                               Foreground="{DynamicResource TextBrushDarker}"/>
                                </StackPanel>

                            </Border>
                        </UniformGrid>

                        <!-- 최저 평가 게임 (작은 카드) -->
                        <!-- Image 대신 ImageBrush 사용: 이미지 크기가 요약 영역 높이를 늘리지 않게 -->
                        <!-- 글자 크기는 화면 크기에 따라 바뀌지 않음 (코드에서 기본 크기로 고정) -->
                        <Border x:Name="LowestGameCard"
                                Grid.Column="1"
                                Background="{DynamicResource GridItemBackgroundBrush}"
                                CornerRadius="8"
                                Margin="4"
                                ClipToBounds="True">

                            <Grid>
                                <Border>
                                    <Border.Background>
                                        <ImageBrush x:Name="LowestGameImage"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>

                                <!-- 레이어 높이 = 글자 높이에 맞춤 -->
                                <Border Style="{StaticResource CardTextOverlayStyle}"
                                        Height="Auto"
                                        Padding="25,16">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOC_CGR_Stats_Lowest}"
                                                   Foreground="{DynamicResource NegativeRatingBrush}"
                                                   FontWeight="Bold"/>

                                        <TextBlock x:Name="LowestGameText"
                                                   Text="-"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,2"/>

                                        <TextBlock x:Name="LowestScoreText"
                                                   Text="{DynamicResource LOC_CGR_NoRatingData}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>

                <!-- 오른쪽 영역: 카드 크기는 코드(UpdateDashboardCardSizes)에서 계산
                     - 최고 평가 게임: 세로 = 왼쪽 요약 영역 세로, 가로 = 세로 / 1.5
                     - 최근 평가 게임: 남은 가로 공간에 6:9 비율, 아래 정렬 -->
                <!-- Canvas로 감싸서 카드 크기가 대시보드 행 높이에 영향을 주지 않게 함
                     (행 높이는 왼쪽 요약 영역만으로 결정 → 창을 줄이면 카드도 같이 줄어듦) -->
                <Canvas x:Name="DashboardCardHost"
                        Grid.Column="1"
                        Margin="12,0,0,0">
                <Grid x:Name="DashboardCardArea">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 최고 평가 게임 -->
                    <Border x:Name="HighestGameCard"
                            Grid.Column="0"
                            Background="{DynamicResource GridItemBackgroundBrush}"
                            CornerRadius="8"
                            Margin="4"
                            VerticalAlignment="Stretch"
                            ClipToBounds="True">

                        <Grid>
                            <Border>
                                <Border.Background>
                                    <ImageBrush x:Name="HighestGameImage"
                                                Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>

                            <!-- 기준 레이어: 카드 세로의 2/9.
                                 최저/최근 평가 게임 카드의 레이어도 이 높이를 그대로 따라감 -->
                            <Border x:Name="HighestGameOverlay"
                                    Style="{StaticResource CardTextOverlayStyle}">
                                <Viewbox Style="{StaticResource CardTextFitStyle}"
                                         Margin="16,8">
                                    <StackPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource OffsetConverter}, ConverterParameter=-32}">
                                        <TextBlock Text="{DynamicResource LOC_CGR_Stats_Highest}"
                                                   Foreground="{DynamicResource PositiveRatingBrush}"
                                                   FontWeight="Bold"/>

                                        <TextBlock x:Name="HighestGameText"
                                                   Text="-"
                                                   FontSize="{DynamicResource FontSizeLarge}"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,2"/>

                                        <TextBlock x:Name="HighestScoreText"
                                                   Text="{DynamicResource LOC_CGR_NoRatingData}"
                                                   FontSize="{DynamicResource FontSizeLargest}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource GameRatingStarBrush}"/>
                                    </StackPanel>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 최근 평가 게임 (작은 카드, 아래 정렬) -->
                    <Border x:Name="LatestGameCard"
                            Grid.Column="1"
                            Background="{DynamicResource GridItemBackgroundBrush}"
                            CornerRadius="8"
                            Margin="4"
                            VerticalAlignment="Bottom"
                            ClipToBounds="True">

                        <Grid>
                            <Border>
                                <Border.Background>
                                    <ImageBrush x:Name="LatestGameImage"
                                                Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>

                            <!-- 레이어 높이 = 최고 평가 게임 레이어 높이 -->
                            <Border Style="{StaticResource CardTextOverlayStyle}"
                                    Height="{Binding ActualHeight, ElementName=HighestGameOverlay}">
                                <Viewbox Style="{StaticResource CardTextFitStyle}"
                                         Margin="12,6">
                                    <StackPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource OffsetConverter}, ConverterParameter=-24}">
                                        <TextBlock Text="{DynamicResource LOC_CGR_Stats_Latest}"
                                                   Foreground="{DynamicResource GlyphBrush}"
                                                   FontWeight="Bold"/>

                                        <TextBlock x:Name="LatestGameText"
                                                   Text="-"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,2"/>

                                        <TextBlock x:Name="LatestScoreText"
                                                   Text="{DynamicResource LOC_CGR_NoRatingData}"
                                                   FontSize="{DynamicResource FontSizeLarger}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource GameRatingStarBrush}"/>

                                        <TextBlock x:Name="LatestDateText"
                                                   Text=""
                                                   Foreground="{DynamicResource TextBrushDarker}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>

                </Grid>
                </Canvas>
            </Grid>

            <!-- 선호하는 게임 (상위 15개 중 무작위 5개) -->
            <TextBlock Text="{DynamicResource LOC_CGR_Stats_Preferred}"
                       FontSize="{DynamicResource FontSizeLarger}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,12"/>

            <ItemsControl x:Name="PreferredGameList"
                          Margin="4,0,4,28">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 가로 6 : 세로 9 고정 -->
                        <Border Background="{DynamicResource GridItemBackgroundBrush}"
                                CornerRadius="8"
                                Margin="4"
                                VerticalAlignment="Top"
                                Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource AspectRatioConverter}, ConverterParameter=1.5}"
                                ClipToBounds="True">

                            <Grid>
                                <Image Source="{Binding CoverImageSource}"
                                       Stretch="UniformToFill"/>

                                <!-- 선호하는 게임 카드: 레이어 높이 = 글자 높이에 맞춤
                                     글자 크기 = '후한 평가 요소'의 항목 이름 글자 크기 (화면 크기에 따라 같이 변함) -->
                                <Border Style="{StaticResource CardTextOverlayStyle}"
                                        Height="Auto"
                                        Padding="25,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding GameName}"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,2"
                                                   FontSize="{Binding FontSize, ElementName=MostGenerousCategoryText}"/>

                                        <TextBlock Text="{Binding AverageScore, StringFormat=★{0}}"
                                                   Foreground="{DynamicResource GameRatingStarBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="{Binding FontSize, ElementName=MostGenerousScoreText}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <!-- 최근 평가한 게임 (기본 10개, 아이콘이 64px보다 작아지면 5개) -->
            <TextBlock Text="{DynamicResource LOC_CGR_Stats_Recent}"
                       FontSize="{DynamicResource FontSizeLarger}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,12"/>

            <ItemsControl x:Name="RecentGameCards"
                          Margin="4,0,4,28"
                          SizeChanged="RecentGameCards_SizeChanged">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding RecentGameColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 마우스를 올리면 테두리에 Glyph 색 표시 (더블클릭으로 평가창 열림 암시) -->
                        <Border Background="{DynamicResource GridItemBackgroundBrush}"
                                CornerRadius="8"
                                Margin="3"
                                Padding="6"
                                BorderThickness="2"
                                Cursor="Hand"
                                ToolTip="{DynamicResource LOC_CGR_Stats_DoubleClickToOpen}"
                                MouseLeftButtonDown="RecentGameCard_MouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- 아이콘 (카드 가로 길이에 맞춘 정사각형) -->
                                    <RowDefinition Height="*"/>    <!-- 게임 이름 -->
                                    <RowDefinition Height="Auto"/> <!-- 평점 -->
                                </Grid.RowDefinitions>

                                <!-- 1. 아이콘 -->
                                <Border Grid.Row="0"
                                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource AspectRatioConverter}, ConverterParameter=1}"
                                        Background="{DynamicResource GridItemBackgroundBrush}"
                                        CornerRadius="6"
                                        ClipToBounds="True">
                                    <Image Source="{Binding IconSource}" Stretch="Uniform"/>
                                </Border>

                                <!-- 2. 게임 이름 -->
                                <TextBlock Grid.Row="1"
                                        Text="{Binding GameName}"
                                        Foreground="{DynamicResource TextBrush}"
                                        FontWeight="Bold"
                                        TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis"
                                        MaxHeight="40"
                                        VerticalAlignment="Center"
                                        Margin="0,7,0,4"/>

                                <!-- 3. 평점 -->
                                <TextBlock Grid.Row="2"
                                        Text="{Binding AverageScore, StringFormat=★{0}}"
                                        Foreground="{DynamicResource GameRatingStarBrush}"
                                        FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <!-- 카테고리별 평균 -->
            <TextBlock Text="{DynamicResource LOC_CGR_Stats_CategoryAverages}"
                       FontSize="{DynamicResource FontSizeLarger}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,12"/>

            <Border Background="{DynamicResource GridItemBackgroundBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="4,0,4,24">

                <ItemsControl x:Name="CategoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>

                                <ProgressBar Grid.Column="1"
                                             Value="{Binding AverageScore}"
                                             Maximum="100"
                                             Height="12"
                                             Foreground="{DynamicResource GameRatingStarBrush}"
                                             VerticalAlignment="Center"/>

                                <!-- 숫자 + 언어별 단위 (점 / pts) -->
                                <TextBlock Grid.Column="2"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding AverageScore, Mode=OneWay}"/><Run Text="{DynamicResource LOC_CGR_Stats_ScoreSuffix}"/>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Border>

            <!-- 점수 분포 -->
            <TextBlock Text="{DynamicResource LOC_CGR_Stats_Distribution}"
                       FontSize="{DynamicResource FontSizeLarger}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,12"/>

            <Border Background="{DynamicResource GridItemBackgroundBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="4,0,4,24">

                <ItemsControl x:Name="ScoreRangeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>

                                <ProgressBar Grid.Column="1"
                                             Value="{Binding Percentage}"
                                             Maximum="100"
                                             Height="12"
                                             Foreground="{DynamicResource GameRatingStarBrush}"
                                             VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Count}"
                                           Foreground="{DynamicResource TextBrushDarker}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Border>

            <!-- 전체 평가 목록 -->
            <TextBlock Text="{DynamicResource LOC_CGR_Stats_AllRatings}"
                       FontSize="{DynamicResource FontSizeLarger}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,12"/>

            <!-- 검색 / 정렬 / 필터 -->
            <Border Background="{DynamicResource GridItemBackgroundBrush}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="4,0,4,12">

                <StackPanel>

                    <TextBlock Text="{DynamicResource LOC_CGR_Stats_SearchGame}"
                               Foreground="{DynamicResource TextBrushDarker}"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="GameSearchBox"
                             Height="32"
                             Padding="8,4"
                             TextChanged="GameSearchBox_TextChanged"
                             ToolTip="{DynamicResource LOC_CGR_Stats_SearchTooltip}"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,6,0">

                            <TextBlock Text="{DynamicResource LOC_CGR_Stats_SortBy}"
                                       Foreground="{DynamicResource TextBrushDarker}"
                                       Margin="0,0,0,5"/>

                            <ComboBox x:Name="SortComboBox"
                                      SelectedIndex="0"
                                      SelectionChanged="Filter_SelectionChanged">

                                <ComboBoxItem Content="{DynamicResource LOC_CGR_Stats_SortScoreDesc}"/>
                                <ComboBoxItem Content="{DynamicResource LOC_CGR_Stats_SortScoreAsc}"/>
                                <ComboBoxItem Content="{DynamicResource LOC_CGR_Stats_SortRecent}"/>
                                <ComboBoxItem Content="{DynamicResource LOC_CGR_Stats_SortName}"/>

                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="6,0,0,0">

                            <TextBlock Text="{DynamicResource LOC_CGR_Stats_RatingStatus}"
                                       Foreground="{DynamicResource TextBrushDarker}"
                                       Margin="0,0,0,5"/>

                            <ComboBox x:Name="RatingFilterComboBox"
                                      SelectedIndex="0"
                                      SelectionChanged="Filter_SelectionChanged">

                                <ComboBoxItem Content="{DynamicResource LOC_CGR_Stats_FilterAllGames}"/>
                                <ComboBoxItem Content="{DynamicResource LOC_CGR_Stats_Rated}"/>
                                <ComboBoxItem Content="{DynamicResource LOC_CGR_Stats_Unrated}"/>

                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource LOC_CGR_Stats_ScoreRange}"
                               Foreground="{DynamicResource TextBrushDarker}"
                               Margin="0,12,0,5"/>

                    <ComboBox x:Name="ScoreFilterComboBox"
                              SelectedIndex="0"
                              SelectionChanged="Filter_SelectionChanged">

                        <ComboBoxItem Content="{DynamicResource LOC_CGR_Stats_AllScores}"/>
                        <ComboBoxItem Content="{DynamicResource LOC_CGR_Stats_Range_0_59}"/>
                        <ComboBoxItem Content="{DynamicResource LOC_CGR_Stats_Range_60_79}"/>
                        <ComboBoxItem Content="{DynamicResource LOC_CGR_Stats_Range_80_89}"/>
                        <ComboBoxItem Content="{DynamicResource LOC_CGR_Stats_Range_90_100}"/>

                    </ComboBox>

                </StackPanel>
            </Border>

            <ListView x:Name="GameList"
                      Margin="0,0,0,24"
                      Foreground="{DynamicResource TextBrush}"
                      MouseDoubleClick="GameList_MouseDoubleClick">

                <ListView.View>
                    <GridView>

                        <GridViewColumn Header="{StaticResource LOC_CGR_Stats_ColumnGameName}"
                                        DisplayMemberBinding="{Binding GameName}"
                                        Width="300"/>

                        <GridViewColumn Header="{StaticResource LOC_CGR_Stats_ColumnScore}"
                                        DisplayMemberBinding="{Binding AverageScore}"
                                        Width="100"/>

                    </GridView>
                </ListView.View>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</UserControl>
