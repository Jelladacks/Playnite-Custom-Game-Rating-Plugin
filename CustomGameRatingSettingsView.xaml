
<UserControl x:Class="CustomGameRating.CustomGameRatingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="600">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 설명 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource LOC_CGR_Settings_CategoryHeader}"
                       FontSize="16"
                       FontWeight="Bold"/>

            <TextBlock Text="{DynamicResource LOC_CGR_Settings_CategoryDesc1}"
                       Margin="0,5,0,0"
                       Foreground="Gray"/>

            <TextBlock Text="{DynamicResource LOC_CGR_Settings_CategoryDesc2}"
                       Foreground="Gray"/>
        </StackPanel>

        <!-- 평가 항목 목록 -->
        <DataGrid x:Name="CategoryGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding Settings.Categories}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  Margin="0,0,0,10">

            <DataGrid.Columns>

                <DataGridTemplateColumn Header="ID" Width="2*">

                    <!-- 평상시 표시 -->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Id}"
                                    VerticalAlignment="Center"
                                    Margin="6,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <!-- 편집 시 자동완성 ComboBox -->
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                                ItemsSource="{Binding DataContext.KnownCategoryIds,
                                    RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEditable="True"
                                IsTextSearchEnabled="True"
                                IsTextSearchCaseSensitive="False"
                                StaysOpenOnEdit="True"
                                IsDropDownOpen="False"
                                PreviewKeyUp="CategoryIdComboBox_PreviewKeyUp"
                                MinWidth="100"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>

                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{StaticResource LOC_CGR_Settings_ColumnDisplayName}"
                                    Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                    Width="2*"/>

                <DataGridCheckBoxColumn Header="{StaticResource LOC_CGR_Settings_ColumnEnabled}"
                                        Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                        Width="Auto"/>

                <DataGridTextColumn Header="{StaticResource LOC_CGR_Settings_ColumnOrder}"
                                    Binding="{Binding Order}"
                                    IsReadOnly="True"
                                    Width="60"/>

            </DataGrid.Columns>
        </DataGrid>

        <!-- 항목 관리 버튼 -->
        <WrapPanel Grid.Row="2"
                   Margin="0,0,0,10">

            <Button Padding="10,2" Content="{DynamicResource LOC_CGR_Settings_AddCategory}"
                    MinWidth="90"
                    Margin="0,0,5,0"
                    Click="AddCategory_Click"/>

            <Button Padding="10,2" Content="{DynamicResource LOC_CGR_Settings_RemoveCategory}"
                    MinWidth="110"
                    Margin="0,0,15,0"
                    Click="RemoveCategory_Click"/>

            <Button Padding="10,2" Content="{DynamicResource LOC_CGR_Settings_MoveUp}"
                    MinWidth="65"
                    Margin="0,0,5,0"
                    Click="MoveUp_Click"/>

            <Button Padding="10,2" Content="{DynamicResource LOC_CGR_Settings_MoveDown}"
                    MinWidth="65"
                    Click="MoveDown_Click"/>

        </WrapPanel>

        <!-- 안내 -->
        <TextBlock Grid.Row="3"
                   Text="{DynamicResource LOC_CGR_Settings_RemoveNote}"
                   Foreground="Gray"
                   TextWrapping="Wrap"/>

        <!-- 평가 데이터 백업 및 복원 -->
        <Border Grid.Row="4"
                BorderBrush="{DynamicResource PopupBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,15,0,0">

            <StackPanel>

                <TextBlock Text="{DynamicResource LOC_CGR_Settings_DataHeader}"
                        FontSize="16"
                        FontWeight="Bold"/>

                <TextBlock Text="{DynamicResource LOC_CGR_Settings_DataDesc}"
                        Foreground="Gray"
                        TextWrapping="Wrap"
                        Margin="0,5,0,10"/>

                <WrapPanel>

                    <Button Padding="10,2" Content="{DynamicResource LOC_CGR_Settings_ExportBackup}"
                            MinWidth="120"
                            Margin="0,0,8,0"
                            Click="ExportBackup_Click"/>

                    <Button Padding="10,2" Content="{DynamicResource LOC_CGR_Settings_ImportBackup}"
                            MinWidth="120"
                            Click="ImportBackup_Click"/>

                </WrapPanel>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
